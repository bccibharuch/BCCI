# Caddy obtains and renews the HTTPS certificate for SITE_DOMAIN on its own
# (Let's Encrypt). Ports 80 and 443 must be open and the domain's A record
# must point at this server before the first start.
#
# Static assets are served straight off disk here rather than proxied to the
# app: one process serves HTML/CSS/JS/images with cache headers and
# compression, so the app tier only ever handles /api/*. That is the single
# biggest lever on request capacity — see docs/SCALING.md.

{$SITE_DOMAIN} {
	encode zstd gzip

	# Applications carry scanned documents; the app itself caps bodies at
	# 3.5 MB, so anything larger is turned away here first.
	request_body {
		max_size 5MB
	}

	# API → the app tier. Caddy load-balances across every `app` replica when
	# the service is scaled out.
	@api path /api /api/*
	handle @api {
		reverse_proxy app:3000
	}

	# Budgeted assets (images, vendored libs): cache hard.
	handle /assets/* {
		root * /srv/bcci
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# CSS/JS carry ?v= cache-busting tokens bumped on every change; a week is safe.
	handle /css/* {
		root * /srv/bcci
		header Cache-Control "public, max-age=604800"
		file_server
	}
	handle /js/* {
		root * /srv/bcci
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Everything else is the SPA: serve a real file if it exists, otherwise
	# hand back index.html. HTML is never cached, so a deploy is picked up at once.
	handle {
		root * /srv/bcci
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

# www.<domain> redirects to the bare domain. Needs its own DNS record; until
# it has one, Caddy logs a certificate error for it and the main site is
# unaffected.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
