# /opt/bcci/.env — settings for the portal on the VPS.
#
# setup-vps.sh copies this file to /opt/bcci/.env (mode 600) and fills in
# the generated secrets. Edit the rest, then: sudo /opt/bcci/deploy/deploy.sh
# Never commit the filled-in copy.

# ── Site ──────────────────────────────────────────────────────────
# The domain Caddy serves and gets the HTTPS certificate for.
SITE_DOMAIN=bccibharuch.in
ALLOWED_ORIGIN=https://bccibharuch.in

# ── Admin sign-in ─────────────────────────────────────────────────
ADMIN_EMAILS=admin@bccibharuch.in
# 20+ random characters: openssl rand -base64 24
ADMIN_PASSWORD=

# ── Email (your SMTP server) ──────────────────────────────────────
SMTP_HOST=
# 465 = TLS from the start; 587 = STARTTLS. Plain, unencrypted SMTP is refused.
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BCCI Bharuch <noreply@bccibharuch.in>"

# ── Generated by setup-vps.sh — keep them secret ──────────────────
POSTGRES_PASSWORD=
INTERNAL_API_SECRET=

# ── Backups ───────────────────────────────────────────────────────
# Local copies, every 6 hours.
BACKUP_DIR=/var/backups/bcci
BACKUP_KEEP_DAYS=14
# Optional, strongly recommended: an rclone remote for an off-server copy,
# e.g. r2:bcci-backups after `sudo rclone config`. Leave empty to keep
# backups on this server only (plus your VPS provider's own backups).
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=30
